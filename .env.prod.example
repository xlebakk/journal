# Production settings (docs/deploy.md). Copy to .env.prod on the server, chmod 600, fill in.
# Generate secrets:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Fernet key:        python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# --- Site
JOURNAL_DOMAIN=journal.example.com
ACME_EMAIL=admin@example.com
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=journal.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://journal.example.com

# --- 2FA secrets encryption (first key encrypts, all decrypt; keep old keys when rotating)
TOTP_ENCRYPTION_KEYS=change-me
TOTP_ISSUER=Journal

# --- PostgreSQL: superuser (container only), owner (migrations), app (rows only)
POSTGRES_PASSWORD=change-me
DB_NAME=journal
DB_OWNER_USER=journal_owner
DB_OWNER_PASSWORD=change-me
DB_USER=journal_app
DB_PASSWORD=change-me

# --- Redis (sessions, login limits)
REDIS_PASSWORD=change-me

# --- Android app origins allowed by CORS (default is right for Capacitor)
# APP_ORIGINS=https://localhost,capacitor://localhost
