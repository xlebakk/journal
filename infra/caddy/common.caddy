# Shared by the production site and the local/CI test stand (Caddyfile.e2e).
# HTTPS only, HSTS for a year, strict CSP, no inline scripts or external CDNs.

(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Frame-Options "DENY"
		-Server
		-Via
	}
}

(journal_app) {
	encode zstd gzip

	# The API: Django behind gunicorn. Caddy adds X-Forwarded-For/-Proto itself.
	handle /api/* {
		# Children's data: never kept in browser or proxy caches.
		header Cache-Control "no-store"
		reverse_proxy {$JOURNAL_API:api:8000} {
			header_up -X-Forwarded-Host
		}
	}

	# The single-page app: files from the build, everything else → index.html.
	handle {
		root * {$JOURNAL_ROOT:/srv}
		# Hashed bundles never change: cache for a year.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Everything else — the shell for every app route, sw.js, the manifest — is revalidated.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# Structured access log; Caddy redacts Cookie and Authorization by default. The secret of
	# an iCal link (`/api/v1/calendar/<id>.ics?token=…`) is masked too.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
