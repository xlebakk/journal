# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- PostgreSQL: the application role (not a superuser)
DB_NAME=journal
DB_USER=journal
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Container superuser, used only by the postgres image to initialise the cluster
POSTGRES_PASSWORD=change-me-too

# --- Redis (password is required)
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
